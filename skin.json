{
    "name": "steam-rice",
    "author": "Pota",
    "description": "Linux-rice look for Steam: misty wallpaper behind the library, panes split by thin lines, Iosevka, quiet black-and-white pictures. Nothing in the top bar is moved. Greyscale without extra rules: a small script recolours Steam's own style sheets.",
    "version": "1.2.0",
    "tags": [
        "Dark",
        "Minimal",
        "Greyscale",
        "Rice",
        "Background"
    ],
    "header_image": "https://raw.githubusercontent.com/Plyxen/steam-rice/main/assets/library.png",
    "splash_image": "https://raw.githubusercontent.com/Plyxen/steam-rice/main/assets/library.png",
    "github": {
        "owner": "Plyxen",
        "repo_name": "steam-rice"
    },
    "Steam-WebKit": "webkit.css",
    "Patches": [
        {
            "MatchRegexString": ".*",
            "TargetCss": "rice.css",
            "TargetJs": "mono.js"
        }
    ],
    "Conditions": {
        "Font": {
            "description": "Iosevka is the terminal font of the rice. Steam is Motiva Sans, the stock one.",
            "default": "Iosevka",
            "tab": "Look",
            "values": {
                "Iosevka": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/font-iosevka.css"
                    }
                },
                "Steam": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/font-steam.css"
                    }
                }
            }
        },
        "Corners": {
            "description": "How round buttons, fields and menus are.",
            "default": "Small",
            "tab": "Look",
            "values": {
                "Sharp": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/corners-sharp.css"
                    }
                },
                "Small": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/corners-small.css"
                    }
                },
                "Round": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/corners-round.css"
                    }
                }
            }
        },
        "Wallpaper dim": {
            "description": "How dark the wallpaper is behind the library. Go heavier if text is hard to read.",
            "default": "Medium",
            "tab": "Look",
            "values": {
                "Light": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/wallpaper-dim-light.css"
                    }
                },
                "Medium": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/wallpaper-dim-medium.css"
                    }
                },
                "Heavy": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/wallpaper-dim-heavy.css"
                    }
                }
            }
        },
        "Film grain": {
            "description": "Fine grain over the wallpaper.",
            "default": "yes",
            "tab": "Look",
            "values": {
                "yes": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/grain-yes.css"
                    }
                },
                "no": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/grain-no.css"
                    }
                }
            }
        },
        "Pictures": {
            "description": "Quiet: game pictures are black-and-white and a little darker until the mouse is on them, and a game page opens on its logo instead of a banner. Grey: the same, without the colour under the mouse. Steam: as Steam has them.",
            "default": "Quiet",
            "tab": "Look",
            "values": {
                "Quiet": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/pictures-quiet.css"
                    }
                },
                "Grey": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/pictures-grey.css"
                    }
                },
                "Steam": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/pictures-steam.css"
                    }
                }
            }
        },
        "Store and community pages": {
            "description": "These are web pages with their own colours. Muted turns them down to sit next to the grey client, Greyscale removes colour, Steam leaves them alone.",
            "default": "Muted",
            "tab": "Look",
            "values": {
                "Muted": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/web-saturation-muted.css"
                    }
                },
                "Greyscale": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/web-saturation-greyscale.css"
                    }
                },
                "Steam": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/web-saturation-steam.css"
                    }
                }
            }
        },
        "Lowercase tabs": {
            "description": "store library community, instead of STORE LIBRARY COMMUNITY. They stay where Steam has them either way.",
            "default": "yes",
            "tab": "Top bar",
            "values": {
                "yes": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/lowercase-tabs-yes.css"
                    }
                },
                "no": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/lowercase-tabs-no.css"
                    }
                }
            }
        },
        "Dots in the window buttons": {
            "description": "A dot that lights up under the mouse, instead of - [] x. The buttons keep their size and place.",
            "default": "yes",
            "tab": "Top bar",
            "values": {
                "yes": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/window-dots-yes.css"
                    }
                },
                "no": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/window-dots-no.css"
                    }
                }
            }
        },
        "Hide megaphone and Big Picture buttons": {
            "description": "The two extra buttons in the top bar. View > Big Picture Mode still works.",
            "default": "yes",
            "tab": "Top bar",
            "values": {
                "yes": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/hide-title-buttons-yes.css"
                    }
                },
                "no": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/hide-title-buttons-no.css"
                    }
                }
            }
        },
        "Hide What's New": {
            "description": "The news strip at the top of the library home.",
            "default": "yes",
            "tab": "Library",
            "values": {
                "yes": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/hide-whats-new-yes.css"
                    }
                },
                "no": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/hide-whats-new-no.css"
                    }
                }
            }
        }
    }
}
